# Dependencies (none today, but a future build step would land here)
node_modules/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE scratch
*.swp
*.swo
*~

# Temp and backup files
*.orig
*.bak

# Local verification scaffolding
__*.html
__*.js

# Python bytecode (tools/build-images.py)
__pycache__/
*.pyc

# Local environment and secrets - never commit these
.env
.env.local
*.pem

# NOTE: assets/img/*.webp is generated by tools/build-images.py but IS
# committed on purpose, so the site deploys to any static host without
# requiring Python.